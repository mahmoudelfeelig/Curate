{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feedpassport.dev/contracts/event-envelope.schema.json",
  "title": "EventEnvelope",
  "description": "A sanitized append-only event envelope. Secrets and raw private content are forbidden.",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "event_type",
    "occurred_at",
    "actor",
    "trace_id",
    "payload",
    "contains_sensitive_data",
    "credentials_included",
    "raw_private_content_included"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "event_id": {
      "$ref": "common.schema.json#/$defs/EventId"
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "passport",
        "migration",
        "overlay",
        "companion_blend",
        "action_envelope",
        "receipt",
        "evaluation",
        "connection"
      ]
    },
    "aggregate_id": {
      "$ref": "common.schema.json#/$defs/NonSecretRef"
    },
    "aggregate_version": {
      "$ref": "common.schema.json#/$defs/ResourceVersion"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "passport.created",
        "passport.updated",
        "passport.checkpointed",
        "migration.started",
        "migration.completed",
        "migration.stopped",
        "envelope.requested",
        "envelope.approved",
        "envelope.rejected",
        "action.executed",
        "action.failed",
        "rollback.started",
        "rollback.completed",
        "overlay.activated",
        "overlay.expired",
        "overlay.revoked",
        "companion.started",
        "companion.expired",
        "companion.revoked",
        "evaluation.completed",
        "drift.detected",
        "drift.corrected"
      ]
    },
    "occurred_at": {
      "$ref": "common.schema.json#/$defs/DateTime"
    },
    "actor": {
      "$ref": "common.schema.json#/$defs/Actor"
    },
    "trace_id": {
      "$ref": "common.schema.json#/$defs/TraceId"
    },
    "correlation_id": {
      "$ref": "common.schema.json#/$defs/NonSecretRef"
    },
    "causation_event_id": {
      "$ref": "common.schema.json#/$defs/EventId"
    },
    "payload": {
      "type": "object",
      "required": [
        "payload_schema",
        "fields"
      ],
      "properties": {
        "payload_schema": {
          "$ref": "common.schema.json#/$defs/NonSecretRef"
        },
        "fields": {
          "$ref": "common.schema.json#/$defs/PublicPayload",
          "propertyNames": {
            "not": {
              "pattern": "(?:[Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Cc][Oo][Oo][Kk][Ii][Ee]|[Oo][Aa][Uu][Tt][Hh]|[Rr][Aa][Ww][_-]?(?:[Ff][Ee][Ee][Dd]|[Cc][Oo][Nn][Tt][Ee][Nn][Tt]|[Hh][Ii][Ss][Tt][Oo][Rr][Yy]))"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "contains_sensitive_data": {
      "type": "boolean",
      "const": false
    },
    "credentials_included": {
      "type": "boolean",
      "const": false
    },
    "raw_private_content_included": {
      "type": "boolean",
      "const": false
    }
  },
  "additionalProperties": false
}
