{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feedpassport.dev/contracts/proposed-action.schema.json",
  "title": "ProposedAction",
  "description": "One bounded action proposed inside a user-visible action envelope.",
  "type": "object",
  "required": [
    "schema_version",
    "action_id",
    "envelope_id",
    "platform",
    "account_ref",
    "action_kind",
    "execution_mode",
    "target",
    "details",
    "expected_effect",
    "confidence",
    "reversible",
    "requires_human_step",
    "policy_reason_codes"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "action_id": {
      "$ref": "common.schema.json#/$defs/ActionId"
    },
    "envelope_id": {
      "$ref": "common.schema.json#/$defs/EnvelopeId"
    },
    "platform": {
      "$ref": "common.schema.json#/$defs/PlatformKey"
    },
    "account_ref": {
      "$ref": "common.schema.json#/$defs/NonSecretRef"
    },
    "action_kind": {
      "$ref": "common.schema.json#/$defs/ActionKind"
    },
    "execution_mode": {
      "$ref": "common.schema.json#/$defs/ExecutionMode"
    },
    "target": {
      "$ref": "common.schema.json#/$defs/ActionTarget"
    },
    "details": {
      "$ref": "common.schema.json#/$defs/ActionDetails"
    },
    "expected_effect": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500
    },
    "confidence": {
      "$ref": "common.schema.json#/$defs/Ratio"
    },
    "reversible": {
      "type": "boolean"
    },
    "requires_human_step": {
      "type": "boolean"
    },
    "policy_reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/NonSecretRef"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_mode": {
            "const": "guided"
          }
        },
        "required": [
          "execution_mode"
        ]
      },
      "then": {
        "properties": {
          "requires_human_step": {
            "const": true
          },
          "details": {
            "required": [
              "instruction_steps"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "requires_human_step": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_kind": {
            "const": "guided_step"
          }
        },
        "required": [
          "action_kind"
        ]
      },
      "then": {
        "properties": {
          "execution_mode": {
            "const": "guided"
          },
          "requires_human_step": {
            "const": true
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
