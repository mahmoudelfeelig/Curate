# Frontend
VITE_CURATOR_API_URL=http://127.0.0.1:8000
# The browser callback must exactly match a backend allowlist entry and every
# provider registration. The browser stores no bearer token in localStorage.
VITE_FEED_PASSPORT_OAUTH_REDIRECT_URI=http://127.0.0.1:5173/oauth/callback

# Optional browser OIDC Authorization Code + PKCE client. Configure the client
# ID, hosted UI origin, and issuer together. This must be a public client with no
# browser client secret. The OIDC callback is distinct from the social callback.
VITE_FEED_PASSPORT_OIDC_CLIENT_ID=
VITE_FEED_PASSPORT_OIDC_HOSTED_UI_URL=
VITE_FEED_PASSPORT_OIDC_ISSUER=
VITE_FEED_PASSPORT_OIDC_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
VITE_FEED_PASSPORT_OIDC_LOGOUT_URI=http://127.0.0.1:5173/
VITE_FEED_PASSPORT_OIDC_SCOPES=openid feed-passport/invoke

# Local curator state. Keep the real database outside version control.
FEED_PASSPORT_DB_PATH=./artifacts/local/feed-passport.db
FEED_PASSPORT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FEED_PASSPORT_BIND_HOST=127.0.0.1
# Opt in only for a loopback process. The route parses a user-selected export
# in memory and never contacts Instagram or any model provider.
FEED_PASSPORT_ENABLE_LOCAL_IMPORT=0

# The standalone FastAPI app owns a due-job runner and enables it by default.
FEED_PASSPORT_SCHEDULER_ENABLED=1
# Positive polling interval; separate from each drift monitor's 15-1440 minute cadence.
FEED_PASSPORT_SCHEDULER_INTERVAL_SECONDS=5

# Use a random value of at least 32 bytes outside local demos.
FEED_PASSPORT_CONSENT_SECRET=replace-with-a-random-secret

# Owner authentication. OIDC is the deployment boundary. The insecure override
# is only an explicit one-person, loopback-only dummy-account test harness; it
# must remain 0 for deployments, proxies, LAN access, or shared/team use.
FEED_PASSPORT_AUTH_MODE=demo
FEED_PASSPORT_ALLOW_INSECURE_LOOPBACK_OAUTH=0
FEED_PASSPORT_OIDC_ISSUER=
FEED_PASSPORT_OIDC_AUDIENCE=
FEED_PASSPORT_OIDC_JWKS_URL=
FEED_PASSPORT_OIDC_REQUIRED_SCOPES=feed-passport/invoke

# Genuine model planning is opt-in and local-only. There is no implicit Bedrock,
# hosted API, or paid-provider fallback. Start an offline llama.cpp server bound
# to loopback before enabling this provider.
FEED_PASSPORT_MODEL_PROVIDER=disabled
FEED_PASSPORT_LLAMACPP_BASE_URL=http://127.0.0.1:8080
FEED_PASSPORT_LLAMACPP_MODEL_ID=feed-passport-local-qwen3-1.7b
FEED_PASSPORT_LOCAL_MODEL_TIMEOUT_SECONDS=120

# Connection metadata uses the first two independent URL-safe-base64 32-byte
# keys. Standard YouTube/X/Reddit OAuth tokens additionally require the vault
# key; Bluesky tokens stay in the Node sidecar and do not use that vault key.
# Keep real values in the process environment, a secret manager, or read-only
# mounted secret; never commit them or place them in model/chat context.
FEED_PASSPORT_CONNECTION_KEY_B64=
FEED_PASSPORT_CONNECTION_INDEX_KEY_B64=
FEED_PASSPORT_OAUTH_VAULT_KEY_B64=
FEED_PASSPORT_CONNECTION_KEY_ID=local-v1
FEED_PASSPORT_OAUTH_VAULT_KEY_ID=local-v1
FEED_PASSPORT_PLATFORM_HTTP_TIMEOUT_SECONDS=20
FEED_PASSPORT_OAUTH_REDIRECT_URIS=http://127.0.0.1:5173/oauth/callback

# Standard OAuth clients. Blank IDs leave each provider Guided and disabled.
# Secrets belong only in an untracked local environment or secret manager.
FEED_PASSPORT_YOUTUBE_OAUTH_CLIENT_ID=
FEED_PASSPORT_YOUTUBE_OAUTH_CLIENT_SECRET=
FEED_PASSPORT_YOUTUBE_OAUTH_CLIENT_AUTH=client_secret_post

# X API access is pay-per-use. Leave blank under the zero-spend requirement.
FEED_PASSPORT_X_OAUTH_CLIENT_ID=
FEED_PASSPORT_X_OAUTH_CLIENT_SECRET=
FEED_PASSPORT_X_OAUTH_CLIENT_AUTH=client_secret_basic

# Do not enable Reddit until the Data API use case has explicit provider
# approval. The approval reference is supplied to the live-conformance gate,
# not stored as an application secret here.
FEED_PASSPORT_REDDIT_OAUTH_CLIENT_ID=
FEED_PASSPORT_REDDIT_OAUTH_CLIENT_SECRET=
FEED_PASSPORT_REDDIT_OAUTH_CLIENT_AUTH=client_secret_basic
# Replace every placeholder with the approved app and dummy operator identity.
# Format example only: web:feed-passport-approved-demo:v0.1.0 (by /u/dummy_operator)
FEED_PASSPORT_REDDIT_OAUTH_USER_AGENT=

# Official AT Protocol OAuth/DPoP remains in the Node sidecar. The Python process
# receives only a fixed sidecar origin and a private-hop service secret; it never
# receives an AT Protocol access token or DPoP key.
FEED_PASSPORT_ATPROTO_SIDECAR_URL=
FEED_PASSPORT_ATPROTO_SIDECAR_INTERNAL_SECRET=
FEED_PASSPORT_ATPROTO_APP_CALLBACK_URI=http://127.0.0.1:5173/oauth/callback

# Runnable single-replica AT Protocol sidecar. Its public OAuth metadata, JWKS,
# and callback origin must use HTTPS even when the private listener is local.
# Keep the encrypted store and private key outside the repository.
FEED_PASSPORT_ATPROTO_PUBLIC_ORIGIN=
FEED_PASSPORT_ATPROTO_HOST=127.0.0.1
FEED_PASSPORT_ATPROTO_PORT=4310
FEED_PASSPORT_ATPROTO_STORE_PATH=
FEED_PASSPORT_ATPROTO_STORE_KEY_B64=
FEED_PASSPORT_ATPROTO_STORE_KEY_ID=local-v1
FEED_PASSPORT_ATPROTO_PRIVATE_KEY_FILE=
FEED_PASSPORT_ATPROTO_PRIVATE_KEY_ID=
FEED_PASSPORT_ATPROTO_SIGNING_ALGORITHM=ES256
FEED_PASSPORT_ATPROTO_SCOPE=atproto transition:generic
FEED_PASSPORT_ATPROTO_CLIENT_NAME=Feed Passport
# Optional HTTPS URLs. Leave these variables unset, rather than blank, to use
# the public origin as the client URI and omit policy/terms metadata.
# FEED_PASSPORT_ATPROTO_CLIENT_URI=https://feed-passport.example/
# FEED_PASSPORT_ATPROTO_POLICY_URI=https://feed-passport.example/privacy
# FEED_PASSPORT_ATPROTO_TERMS_URI=https://feed-passport.example/terms

# A live adapter is promoted only by a fresh, signed authorized-dummy-account
# conformance receipt bound to the exact Git revision. Configure these together.
FEED_PASSPORT_LIVE_CERTIFICATIONS_DIR=
FEED_PASSPORT_LIVE_CERTIFICATION_HMAC_KEY_B64=
FEED_PASSPORT_CODE_REVISION=

# AgentCore uses a separate, plan-first contract under infra/agentcore/.env.example.
# Do not put AWS access keys, SSO tokens, Cognito tokens, or platform tokens here.
# The checked-in AgentCore stack is prepared but is not deployed or invoked.
