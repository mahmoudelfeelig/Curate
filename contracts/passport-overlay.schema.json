{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feedpassport.dev/contracts/passport-overlay.schema.json",
  "title": "PassportOverlay",
  "description": "An expiring policy layer applied over a versioned FeedPassport.",
  "type": "object",
  "required": [
    "schema_version",
    "overlay_id",
    "version",
    "passport_id",
    "base_passport_version",
    "title",
    "mode",
    "status",
    "created_at",
    "starts_at",
    "expires_at",
    "added_hard_exclusions",
    "removed_exclusion_refs",
    "consent",
    "rollback_required",
    "underlying_algorithm_training"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "overlay_id": {
      "$ref": "common.schema.json#/$defs/OverlayId"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/ResourceVersion"
    },
    "passport_id": {
      "$ref": "common.schema.json#/$defs/PassportId"
    },
    "base_passport_version": {
      "$ref": "common.schema.json#/$defs/ResourceVersion"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "mode": {
      "type": "string",
      "enum": [
        "isolated_feed",
        "reversible_live"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "active",
        "expired",
        "revoked",
        "rollback_pending",
        "rolled_back"
      ]
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/DateTime"
    },
    "starts_at": {
      "$ref": "common.schema.json#/$defs/DateTime"
    },
    "expires_at": {
      "$ref": "common.schema.json#/$defs/DateTime"
    },
    "topic_targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "common.schema.json#/$defs/TopicTarget"
      }
    },
    "cross_cutting_override": {
      "$ref": "common.schema.json#/$defs/PartialCrossCuttingPolicy"
    },
    "added_hard_exclusions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "common.schema.json#/$defs/HardExclusion"
      }
    },
    "removed_exclusion_refs": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/NonSecretRef"
      }
    },
    "consent": {
      "$ref": "common.schema.json#/$defs/ConsentRecord"
    },
    "rollback_required": {
      "type": "boolean"
    },
    "underlying_algorithm_training": {
      "type": "string",
      "enum": [
        "none_by_design",
        "platform_may_retain_signals"
      ]
    },
    "revoked_at": {
      "$ref": "common.schema.json#/$defs/DateTime"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "isolated_feed"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "rollback_required": {
            "const": false
          },
          "underlying_algorithm_training": {
            "const": "none_by_design"
          }
        }
      },
      "else": {
        "properties": {
          "rollback_required": {
            "const": true
          },
          "underlying_algorithm_training": {
            "const": "platform_may_retain_signals"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "revoked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "revoked_at"
        ]
      }
    }
  ],
  "anyOf": [
    {
      "required": [
        "topic_targets"
      ]
    },
    {
      "properties": {
        "cross_cutting_override": {
          "minProperties": 1
        }
      },
      "required": [
        "cross_cutting_override"
      ]
    },
    {
      "properties": {
        "added_hard_exclusions": {
          "minItems": 1
        }
      },
      "required": [
        "added_hard_exclusions"
      ]
    },
    {
      "properties": {
        "removed_exclusion_refs": {
          "minItems": 1
        }
      },
      "required": [
        "removed_exclusion_refs"
      ]
    }
  ],
  "additionalProperties": false
}
