FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir . \
    && useradd --create-home --uid 10001 agentcore \
    && chown -R agentcore:agentcore /app

USER agentcore
EXPOSE 8080

CMD ["python", "-m", "feed_passport.runtime.agentcore_app"]
