{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feedpassport.dev/contracts/account-observation.schema.json",
  "title": "AccountObservation",
  "description": "A normalized, privacy-bounded observation of one authorized account.",
  "type": "object",
  "required": [
    "schema_version",
    "observation_id",
    "account",
    "capability_manifest_id",
    "captured_at",
    "access_mode",
    "topic_distribution",
    "followed_creator_refs",
    "subscription_refs",
    "native_preferences",
    "evidence",
    "confidence",
    "raw_private_content_included",
    "credentials_included"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "observation_id": {
      "$ref": "common.schema.json#/$defs/ObservationId"
    },
    "account": {
      "$ref": "common.schema.json#/$defs/AccountRef"
    },
    "capability_manifest_id": {
      "$ref": "common.schema.json#/$defs/ManifestId"
    },
    "captured_at": {
      "$ref": "common.schema.json#/$defs/DateTime"
    },
    "access_mode": {
      "type": "string",
      "enum": [
        "official_api",
        "data_export",
        "user_provided",
        "lab_fixture",
        "guided_confirmation"
      ]
    },
    "topic_distribution": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "common.schema.json#/$defs/TopicShare"
      }
    },
    "followed_creator_refs": {
      "type": "array",
      "maxItems": 5000,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/NonSecretRef"
      }
    },
    "subscription_refs": {
      "type": "array",
      "maxItems": 5000,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/NonSecretRef"
      }
    },
    "native_preferences": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "common.schema.json#/$defs/NormalizedState"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "common.schema.json#/$defs/EvidenceRef"
      }
    },
    "confidence": {
      "$ref": "common.schema.json#/$defs/Ratio"
    },
    "raw_private_content_included": {
      "type": "boolean",
      "const": false
    },
    "credentials_included": {
      "type": "boolean",
      "const": false
    }
  },
  "additionalProperties": false
}
