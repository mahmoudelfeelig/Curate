{
  "version": 1,
  "id": "curate",
  "source": {
    "repository": "mahmoudelfeelig/Curate",
    "default_branch": "main",
    "required_workflows": ["Curate CI"]
  },
  "registry": {
    "host": "registry.elfeel.me",
    "image_namespace": "apps/curate",
    "release_repository": "releases/curate"
  },
  "release": {
    "strategy": "source-build",
    "components": [
      {
        "name": "api",
        "context": "services/curator",
        "dockerfile": "services/curator/Dockerfile"
      },
      {
        "name": "oauth",
        "context": "services/atproto-oauth",
        "dockerfile": "services/atproto-oauth/Dockerfile"
      },
      {
        "name": "tunnel",
        "context": ".",
        "dockerfile": "deploy/hetzner/Dockerfile.tunnel"
      }
    ]
  }
}
